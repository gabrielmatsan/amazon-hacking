# Public (exposed to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/v1

# Umami analytics — cookieless (these values are public; they ship in page HTML)
NEXT_PUBLIC_UMAMI_SRC=https://umami-production-c594.up.railway.app/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=ca0941d0-0c44-4608-88e4-e35250f45e27

# Umami session replay (recorder) — on by default. Set to false to opt out.
# recorder.js URL is derived from _SRC (…/script.js → …/recorder.js).
NEXT_PUBLIC_UMAMI_RECORDER=true
NEXT_PUBLIC_UMAMI_RECORDER_SAMPLE_RATE=0.15
NEXT_PUBLIC_UMAMI_RECORDER_MASK_LEVEL=moderate
NEXT_PUBLIC_UMAMI_RECORDER_MAX_DURATION=300000

# API token for server-side vote submission (Server Action → backend)
X_API_TOKEN=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Sentry error monitoring (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
