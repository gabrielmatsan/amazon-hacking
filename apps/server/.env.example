# Database
DATABASE_URL=postgresql://test:test@localhost:5433/app_test
# Liga SSL no Pool do Postgres (use "true" em prod / Railway). Cert autoassinado -> rejectUnauthorized:false
DATABASE_SSL=false

# App
NODE_ENV=development
PORT=8080
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# Google OAuth
# Create credentials at https://console.cloud.google.com/apis/credentials
# Type: OAuth 2.0 Client ID > Web application
# Authorized redirect URI must match GOOGLE_REDIRECT_URI below
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/v1/auth/google/callback

# Redis
REDIS_URL=redis://localhost:6380
REDIS_TLS=false

# AWS (SES + S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
DEFAULT_FROM_EMAIL=noreply@example.com

# S3
S3_PUBLIC_BUCKET_NAME=my-storage
S3_PUBLIC_BUCKET_URL=https://my-storage.s3.amazonaws.com
S3_PUBLIC_URL=https://your-cloudfront-url.cloudfront.net

# OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=my-api
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_LOG_LEVEL=none
OTEL_METRICS_EXPORT_INTERVAL_MS=60000

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Metrics
METRICS_ENABLED=true
METRICS_PREFIX=my_api

# Messaging (WhatsApp via Evolution API or Arara)
# MESSAGE_SENDER=evolution | arara | mock (mock just logs the token instead of sending)
MESSAGE_SENDER=evolution
EVOLUTION_URL=https://evolution.example.com
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE=your-instance-name
EVOLUTION_ALERT_GROUP_ID=120363000000000000
EVOLUTION_ALERTS_ENABLED=false
# Arara (https://docs.ararahq.com) — sends the token via the "envio_de_token" template
ARARA_URL=https://api.ararahq.com/api/v1
ARARA_API_KEY=ara_sk_your-api-key

# Vonage SMS (https://developer.vonage.com/en/messaging/sms/overview)
# Set MESSAGE_SENDER=vonage to use it.
VONAGE_URL=https://rest.nexmo.com
VONAGE_API_KEY=your-8-char-api-key
VONAGE_API_SECRET=your-api-secret
VONAGE_FROM=your-vonage-number-or-sender-id

# Vote token policy
VOTE_TOKEN_TTL_SECONDS=300
VOTE_TOKEN_RATE_LIMIT_COUNT=3
VOTE_TOKEN_RATE_LIMIT_WINDOW_SECONDS=600
VOTE_TOKEN_MAX_ATTEMPTS=5

# Umami Analytics (self-hosted) — powers the admin dashboard. All optional:
# leave blank to disable (the dashboard shows a "not configured" state).
# The Bearer token from /api/auth/login is cached in Redis and re-fetched on 401.
UMAMI_API_URL=https://umami-production-c594.up.railway.app
UMAMI_USERNAME=admin
UMAMI_PASSWORD=
UMAMI_WEBSITE_ID=ca0941d0-0c44-4608-88e4-e35250f45e27
UMAMI_TIMEZONE=America/Belem
UMAMI_TOKEN_TTL_SECONDS=43200
UMAMI_OVERVIEW_CACHE_SECONDS=300
# Target for the "meta de votos" goal widget (vote-submitted conversions).
UMAMI_VOTE_GOAL=500
