# Database
DATABASE_URL=postgresql://test:test@localhost:5433/app_test

# App
NODE_ENV=development
PORT=8080
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# Auth
JWT_SECRET=your-jwt-secret-here

# Redis
REDIS_URL=redis://localhost:6380
REDIS_TLS=false

# AWS (SES + S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
DEFAULT_FROM_EMAIL=noreply@example.com

# S3
S3_PUBLIC_BUCKET_NAME=my-storage
S3_PUBLIC_BUCKET_URL=https://my-storage.s3.amazonaws.com
CLOUDFRONT_URL=https://your-cloudfront-url.cloudfront.net

# OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=my-api
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_LOG_LEVEL=none
OTEL_METRICS_EXPORT_INTERVAL_MS=60000

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Metrics
METRICS_ENABLED=true
METRICS_PREFIX=my_api
