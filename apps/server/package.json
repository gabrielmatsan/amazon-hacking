{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "echo 'Build complete'",
    "dev": "bun run --watch src/app.ts",
    "test": "bun test --env-file=.env.test",
    "test:watch": "bun test --watch",
    "test:unit": "find ./src -name '*.unit.test.ts' -exec bun test {} \\;",
    "test:integration": "find ./src -name '*.integration.test.ts' -exec bun test --env-file=.env.test {} +",
    "test:coverage": "bun test --coverage",
    "test:db:up": "docker-compose -f docker-compose.test.yml up -d",
    "test:db:down": "docker-compose -f docker-compose.test.yml down -v",
    "test:db:migrate": "bun run db:migrate",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1002.0",
    "@aws-sdk/client-sesv2": "^3.914.0",
    "@aws-sdk/s3-request-presigner": "^3.1002.0",
    "@elysiajs/cookie": "^0.8.0",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/swagger": "^1.3.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.213.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.213.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.213.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/instrumentation-http": "^0.213.0",
    "@opentelemetry/instrumentation-ioredis": "^0.61.0",
    "@opentelemetry/instrumentation-pg": "^0.65.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-logs": "^0.213.0",
    "@opentelemetry/sdk-metrics": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@opentelemetry/sdk-trace-node": "^2.6.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "argon2": "^0.44.0",
    "bullmq": "^5.71.0",
    "drizzle-orm": "^0.44.6",
    "elysia": "latest",
    "elysia-rate-limit": "^4.5.1",
    "ioredis": "^5.10.0",
    "jose": "^6.2.2",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.15.5",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.32.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.3.0"
  },
  "module": "src/index.js"
}
